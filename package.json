{
  "name": "jose-pereda-web",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "studio": "sanity dev",
    "studio:build": "sanity build",
    "studio:deploy": "sanity deploy",
    "seed": "node --env-file=.env.local scripts/seed.mjs",
    "format": "prettier --write \"src/**/*.{ts,tsx,css,json}\" \"sanity/**/*.ts\" \"scripts/*.{ts,mjs}\" \"*.{ts,json}\" \"worker/*.{ts,json}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css,json}\" \"sanity/**/*.ts\" \"scripts/*.{ts,mjs}\" \"*.{ts,json}\" \"worker/*.{ts,json}\"",
    "worker:deploy": "wrangler deploy --config worker/wrangler.json",
    "worker:check": "wrangler deploy --dry-run --config worker/wrangler.json",
    "worker:test": "tsx --test worker/contact.test.ts"
  },
  "dependencies": {
    "@fontsource/inter": "^5.2.0",
    "@sanity/client": "^7.0.0",
    "@sanity/image-url": "^1.2.0",
    "next": "^16.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-icons": "^5.5.0",
    "sanity": "^4.0.0",
    "styled-components": "^6.1.15",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "^5.9.0",
    "wrangler": "4.151.0"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
